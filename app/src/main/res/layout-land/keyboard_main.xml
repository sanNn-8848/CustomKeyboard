<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main_keyboard_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_keyboard_container_dark">

    <android.widget.ImageView
        android:id="@+id/frost_glow"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/bg_glow_dark"
        android:contentDescription="@null" />

    <android.widget.ImageView
        android:id="@+id/frost_mountains"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_gravity="bottom"
        android:scaleType="fitXY"
        android:src="@drawable/bg_mountains_dark"
        android:contentDescription="@null" />

    <!-- All interactive content. Narrowed + pinned to one side in one-handed mode. -->
    <LinearLayout
        android:id="@+id/keyboard_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical">

        <!-- One slim top row: [tools toggle] [suggestions | clipboard | emoji | tools].
             Replaces the old 3D carousel strip + separate pane row, giving the
             height back to the keys. Heights are set in code (portrait/landscape). -->
        <LinearLayout
            android:id="@+id/top_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_prediction_bar">

            <TextView
                android:id="@+id/tools_toggle"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="top"
                android:gravity="center"
                android:text="›"
                android:textSize="24sp"
                android:textStyle="bold"
                android:contentDescription="@string/tools_toggle_description"
                android:background="@drawable/bg_tool_button"
                android:layout_margin="0dp" />

            <FrameLayout
                android:id="@+id/feature_pane"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1">

                <com.romannepali.keyboard.SuggestionBar
                    android:id="@+id/suggestion_bar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal" />
            </FrameLayout>
        </LinearLayout>

        <!-- Keyboard -->
        <com.romannepali.keyboard.GboardKeyboardView
            android:id="@+id/keyboard_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent" />
    </LinearLayout>

</FrameLayout>
