<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/action_key_light_pressed" />
            <stroke android:width="1dp" android:color="@color/border_glow_pressed" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/action_key_light" />
            <stroke android:width="1dp" android:color="@color/key_border_light" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>