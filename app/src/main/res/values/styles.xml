<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.RomanNepali" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryVariant">@color/accent_deep</item>
        <item name="colorOnPrimary">#FFFFFFFF</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorSecondaryVariant">@color/accent_deep</item>
        <item name="colorOnSecondary">#FFFFFFFF</item>
        <item name="android:windowBackground">@color/keyboard_bg_dark_top</item>
    </style>

    <style name="Theme.MeroType.Dark" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryVariant">@color/accent_deep</item>
        <item name="colorOnPrimary">#FFFFFFFF</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorSecondaryVariant">@color/accent_deep</item>
        <item name="colorOnSecondary">#FFFFFFFF</item>
        <item name="android:windowBackground">@color/keyboard_bg_dark_top</item>
        <item name="android:statusBarColor">@color/keyboard_bg_dark</item>
        <item name="android:navigationBarColor">@color/keyboard_bg_dark</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.MeroType.Light" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent_deep</item>
        <item name="colorPrimaryVariant">@color/accent</item>
        <item name="colorOnPrimary">#FFFFFFFF</item>
        <item name="colorSecondary">@color/accent_deep</item>
        <item name="colorSecondaryVariant">@color/accent</item>
        <item name="colorOnSecondary">#FFFFFFFF</item>
        <item name="android:windowBackground">@color/keyboard_bg_light_top</item>
        <item name="android:statusBarColor">@color/keyboard_bg_light_top</item>
        <item name="android:navigationBarColor">@color/keyboard_bg_light</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>