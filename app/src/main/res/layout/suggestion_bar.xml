<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingLeft="4dp"
    android:paddingRight="4dp">

    <ImageButton
        android:id="@+id/clock_tap_undo"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:src="@drawable/ic_undo"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/undo_content_description"
        android:visibility="gone"
        android:layout_marginRight="2dp" />

    <ImageButton
        android:id="@+id/settings_gear"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/ic_settings"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/settings_title"
        android:layout_marginRight="4dp" />

    <TextView
        android:id="@+id/suggestion_1"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_weight="1"
        android:gravity="center"
        android:textColor="#FFFFFFFF"
        android:textSize="15sp"
        android:background="@drawable/suggestion_background"
        android:layout_margin="3dp"
        android:padding="6dp"
        android:singleLine="true"
        android:ellipsize="end"
        android:text=""
        android:visibility="invisible" />

    <TextView
        android:id="@+id/suggestion_2"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_weight="1"
        android:gravity="center"
        android:textColor="#FFFFFFFF"
        android:textSize="15sp"
        android:background="@drawable/suggestion_background"
        android:layout_margin="3dp"
        android:padding="6dp"
        android:singleLine="true"
        android:ellipsize="end"
        android:text=""
        android:visibility="invisible" />

    <TextView
        android:id="@+id/suggestion_3"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_weight="1"
        android:gravity="center"
        android:textColor="#FFFFFFFF"
        android:textSize="15sp"
        android:background="@drawable/suggestion_background"
        android:layout_margin="3dp"
        android:padding="6dp"
        android:singleLine="true"
        android:ellipsize="end"
        android:text=""
        android:visibility="invisible" />

</LinearLayout>