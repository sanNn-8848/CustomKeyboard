<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="8dp"
        android:paddingRight="8dp">

        <ImageButton
            android:id="@+id/clock_tap_undo"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_undo"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/undo_content_description"
            android:visibility="gone"
            android:layout_marginRight="2dp" />

        <HorizontalScrollView
            android:id="@+id/suggestion_scroll"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:scrollbars="none"
            android:overScrollMode="never"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/suggestion_chips_container"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical" />
        </HorizontalScrollView>

        <ImageButton
            android:id="@+id/settings_gear"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_settings"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/settings_title"
            android:layout_marginLeft="4dp" />

    </LinearLayout>

    <ImageButton
        android:id="@+id/undo_center"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="center"
        android:padding="6dp"
        android:src="@drawable/ic_undo"
        android:background="@drawable/suggestion_background"
        android:contentDescription="@string/undo_content_description"
        android:visibility="gone" />

</FrameLayout>