<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main_keyboard_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_keyboard_container_dark">

    <!-- Static soft glow behind everything -->
    <android.widget.ImageView
        android:id="@+id/frost_glow"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/bg_glow_dark"
        android:contentDescription="@null" />

    <!-- Barely-visible Himalayan silhouette -->
    <android.widget.ImageView
        android:id="@+id/frost_mountains"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_gravity="bottom"
        android:scaleType="fitXY"
        android:src="@drawable/bg_mountains_dark"
        android:contentDescription="@null" />

    <!-- Content sits on top of the glass -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Suggestion Toolbar -->
        <FrameLayout
            android:id="@+id/suggestion_row"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_prediction_bar">

            <com.romannepali.keyboard.SuggestionBar
                android:id="@+id/suggestion_bar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal" />
        </FrameLayout>

        <!-- Keyboard -->
        <com.romannepali.keyboard.GboardKeyboardView
            android:id="@+id/keyboard_view"
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:background="@android:color/transparent" />
    </LinearLayout>

</FrameLayout>